# --- Database ---
DATABASE_URL=mysql+pymysql://pvc_user:pvc_password@localhost:3306/pvc_card_db

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- File storage ---
UPLOAD_DIR=./storage/uploads
GENERATED_DIR=./storage/generated
MAX_FILE_SIZE=10485760

# --- OCR (configured in Phase 2) ---
OCR_PROVIDER=
OCR_API_KEY=
# Only needed if Tesseract isn't on PATH and isn't at a default install
# location the app already checks automatically (see README's OCR setup
# section). Example Windows value:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Language pack(s) Tesseract uses. eng+tel = English + Telugu (Aadhaar
# prints both). Safe to leave as-is even before installing the Telugu
# pack — it just falls back to English-only extraction until you do.
# See README's "Regional-language OCR" section.
OCR_LANGUAGES=eng+tel

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- App ---
ENV=development
